datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String            @id @default(uuid())
  username       String            @unique
  email          String?           @unique
  passwordHash   String?
  isGuest        Boolean           @default(false)
  coins          Int               @default(1000)
  xp             Int               @default(0)
  level          Int               @default(1)
  rank           String            @default("Bronze V")
  avatar         String            @default("default_avatar")
  diceSkin       String            @default("default_dice")
  boardTheme     String            @default("default_board")
  profileFrame   String            @default("default_frame")
  victoryEffect  String            @default("default_victory")
  bio            String?           @default("")
  language       String            @default("en")
  isBanned       Boolean           @default(false)
  role           String            @default("USER") // USER or ADMIN
  emailVerified  Boolean           @default(false)
  verificationToken String?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  ratingChess    Int               @default(1200)
  ratingLudo     Int               @default(1200)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  // Relations
  sentFriends     Friend[]         @relation("SentRequests")
  receivedFriends Friend[]         @relation("ReceivedRequests")
  sentMessages    Message[]        @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  matchPlayers    MatchPlayer[]
  achievements    UserAchievement[]
  inventory       UserInventory[]
  notifications   Notification[]
}

model Friend {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  
  user      User     @relation("SentRequests", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("ReceivedRequests", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String?  // Null if room message
  roomId     String?  // Null if direct message
  content    String
  createdAt  DateTime @default(now())
  
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User?    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Match {
  id              String        @id @default(uuid())
  gameType        String        // RAMUDU_SEETHA, LUDO, CHESS
  status          String        @default("COMPLETED") // COMPLETED, ABANDONED
  durationSeconds Int           @default(0)
  winnerId        String?
  pgn             String?
  movesJson       String?
  resultType      String?       // CHECKMATE, STALEMATE, RESIGNATION, TIMEOUT, DRAW_MUTUAL, DRAW_INSUFFICIENT, DRAW_THREEFOLD
  reason          String?
  whiteAccuracy   Float?
  blackAccuracy   Float?
  reviewDataJson  String?
  createdAt       DateTime      @default(now())
  
  players         MatchPlayer[]
}

model MatchPlayer {
  id           String   @id @default(uuid())
  matchId      String
  userId       String
  score        Int      @default(0)
  coinsEarned  Int      @default(0)
  placement    Int      @default(1)
  ratingBefore Int?
  ratingAfter  Int?
  ratingChange Int?
  createdAt    DateTime @default(now())
  
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Puzzle {
  id          String   @id @default(uuid())
  fen         String
  moves       String   // e.g. "e2e4 e7e5 g1f3"
  rating      Int      @default(1500)
  difficulty  String   @default("MEDIUM") // EASY, MEDIUM, HARD
  themes      String   // JSON string: ["Mate in 1", "Fork", "Pin"]
  createdAt   DateTime @default(now())
}

model Achievement {
  id          String            @id @default(uuid())
  name        String            @unique
  description String
  badgeUrl    String
  xpReward    Int               @default(100)
  coinsReward Int               @default(50)
  
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model StoreItem {
  id          String          @id @default(uuid())
  type        String          // AVATAR, DICE, BOARD, FRAME, EFFECT
  name        String          @unique
  identifier  String          @unique // e.g. "neon_dice", "space_station_board"
  price       Int
  imageUrl    String
  
  owners      UserInventory[]
}

model UserInventory {
  id           String    @id @default(uuid())
  userId       String
  itemId       String
  purchasedAt  DateTime  @default(now())
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item         StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model UserLike {
  id             String   @id @default(uuid())
  targetUsername String
  likerUsername  String
  createdAt      DateTime @default(now())

  @@unique([targetUsername, likerUsername])
}

model UserReview {
  id             String   @id @default(uuid())
  targetUsername String
  reviewerName   String
  rating         Int
  comment        String
  createdAt      DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  game      String   // e.g. "RAMUDU_SEETHA", "LUDO", "CHESS"
  username  String   // User who submitted the feedback
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model DivisionRank {
  id          String   @id @default(uuid())
  minLevel    Int      @unique
  name        String   @unique
  badgeIcon   String?  @default("bronze_badge")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  senderId   String?
  senderName String?
  type       String   // 'LIKE', 'FRIEND_REQUEST', 'FRIEND_ACCEPT'
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}



